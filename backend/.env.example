PORT=8000
FRONTEND_URL=http://localhost:3000
# true behind https://ngrok ; false for local http
COOKIE_SECURE=false
DATABASE_URL=postgresql://lineup:lineup@localhost:5432/lineup?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
SUBSCRIPTION_SEAT_LIMIT=100
MAX_ACTIVE_SESSIONS=5
NODE_ENV=development
TOS_VERSION=2026-11-26
PRIVACY_VERSION=2026-11-26
# Platega (issued after bank approval — do not use shared test account)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_API_BASE=https://app.platega.io
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=lineup24_bot
# polling = long poll with Nest. webhook = setWebhook on boot. off = disabled.
TELEGRAM_MODE=polling
# Required for TELEGRAM_MODE=webhook, e.g. https://host/api/notifications/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Optional SOCKS5 for api.telegram.org (RU VPS): socks5://user:pass@host:port
TELEGRAM_SOCKS_PROXY=
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="lineup24 <you@yandex.ru>"
# true = return codes in API when SMTP fails (local debug only)
MAIL_EXPOSE_CODES=false
# Web Push (VAPID) — generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@lineup24.ru
