# Shared by docker compose (optional overrides)
POSTGRES_USER=lineup
POSTGRES_PASSWORD=lineup
POSTGRES_DB=lineup

# Browser-facing URLs
# Local: http://localhost:3000
# Tunnel: set by scripts/tunnel.ps1 to https://….ngrok-free.app
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# false for http://localhost ; true behind https ngrok
COOKIE_SECURE=false

# Set true on first boot to seed admin/demo users
RUN_SEED=false
